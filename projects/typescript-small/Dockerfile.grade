# syntax=docker/dockerfile:1
FROM alpine/git:v2.49.1 AS snapshot
ARG REPO
ARG COMMIT
WORKDIR /snapshot
RUN git init -q . && git remote add origin "$REPO" && git fetch -q --depth 1 origin "$COMMIT" && git checkout -q FETCH_HEAD \
    && rm -rf .git && git init -q -b main . && git add -A && git -c user.name=study -c user.email=study@localhost commit -qm snapshot

FROM node:24.22.2-bookworm
COPY --from=snapshot /snapshot /study/snapshot
# Upstream git-ignores package-lock.json and ships none; this one was resolved once (npm 11.19.1) and is kept here.
COPY package-lock.json /study/snapshot/package-lock.json
RUN cd /study/snapshot && npm ci --ignore-scripts --no-audit --no-fund
