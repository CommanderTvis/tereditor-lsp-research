# syntax=docker/dockerfile:1
FROM alpine/git:v2.49.1 AS snapshot
ARG REPO
ARG COMMIT
WORKDIR /snapshot
RUN git init -q . && git remote add origin "$REPO" && git fetch -q --depth 1 origin "$COMMIT" && git checkout -q FETCH_HEAD \
    && rm -rf .git && git init -q -b main . && git add -A && git -c user.name=study -c user.email=study@localhost commit -qm snapshot

FROM python:3.12.8-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git less && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest==8.3.4
# click is imported from the tree under test (PYTHONPATH=/work/src, see check.sh); some tests read the installed
# version through importlib.metadata, so register distribution metadata only (no code).
RUN d=$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/click-8.5.1.dist-info \
    && mkdir -p "$d" && printf 'Metadata-Version: 2.1\nName: click\nVersion: 8.5.1\n' > "$d/METADATA"
COPY --from=snapshot /snapshot /study/snapshot
