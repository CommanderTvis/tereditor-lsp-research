# syntax=docker/dockerfile:1
FROM alpine/git:v2.49.1 AS snapshot
ARG REPO
ARG COMMIT
WORKDIR /snapshot
RUN git init -q . && git remote add origin "$REPO" && git fetch -q --depth 1 origin "$COMMIT" && git checkout -q FETCH_HEAD \
    && rm -rf .git && git init -q -b main . && git add -A && git -c user.name=study -c user.email=study@localhost commit -qm snapshot

# The tests target net8.0: the .NET 8 runtime is copied next to the SDK's .NET 10 runtime.
FROM mcr.microsoft.com/dotnet/runtime:8.0.33 AS runtime8

FROM mcr.microsoft.com/dotnet/sdk:10.0.403
COPY --from=runtime8 /usr/share/dotnet/shared/Microsoft.NETCore.App /usr/share/dotnet/shared/Microsoft.NETCore.App
ENV DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 NUGET_PACKAGES=/nuget \
    NuGetAudit=false MSBUILDDISABLENODEREUSE=1
COPY --from=snapshot /snapshot /study/snapshot
# Restore (network) and build once, so every package is in /nuget for the offline restore at grade time.
RUN cd /study/snapshot && dotnet restore MediatR.sln && dotnet build MediatR.sln --no-restore -v q -nologo \
    && rm -rf $(find . -type d \( -name bin -o -name obj \) -prune)
