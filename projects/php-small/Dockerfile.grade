# syntax=docker/dockerfile:1
FROM alpine/git:v2.49.1 AS snapshot
ARG REPO
ARG COMMIT
WORKDIR /snapshot
RUN git init -q . && git remote add origin "$REPO" && git fetch -q --depth 1 origin "$COMMIT" && git checkout -q FETCH_HEAD \
    && rm -rf .git && git init -q -b main . && git add -A && git -c user.name=study -c user.email=study@localhost commit -qm snapshot

FROM composer:2.11.1 AS composer

FROM php:8.4.27-cli-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git unzip && rm -rf /var/lib/apt/lists/*
COPY --from=composer /usr/bin/composer /usr/bin/composer
COPY --from=snapshot /snapshot /study/snapshot
# composer.lock is git-ignored upstream; this one pins every dependency (generated with PHP 8.4.27, composer 2.11.1).
COPY composer.lock /study/snapshot/composer.lock
RUN cd /study/snapshot && COMPOSER_ALLOW_SUPERUSER=1 composer install --no-interaction --no-progress --no-plugins --no-scripts \
    && git status --porcelain | (! grep .)
