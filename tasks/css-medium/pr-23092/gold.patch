+/**
+ * ----------
+ * Tearsheet
+ * ----------
+ */
+
+export interface TearsheetProps extends ComposedModalProps {
+  children?: React.ReactNode;
+
+  /**
+   * Whether the tearsheet is currently open.
+   */
+  open?: boolean;
+
+  /**
+   * Optional class names added to the modal wrapper.
