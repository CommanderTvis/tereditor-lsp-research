+            selectorsFloatingMenus={[
+              `.${carbonPrefix}--overflow-menu-options`,
+              `.${carbonPrefix}--tooltip`,
+              '.flatpickr-calendar',
+              `.${blockClass}__container`,
+              `.${carbonPrefix}--menu`,
+              ...selectorsFloatingMenus,
+            ]}
