+              [`${blockClass}--narrow`]: variant === 'narrow',
+              [`${blockClass}--stacked`]: depth > 0,
+              [`${blockClass}--stack-activated`]: stack.length > 1,
+              [`${blockClass}--has-ai-label`]:
