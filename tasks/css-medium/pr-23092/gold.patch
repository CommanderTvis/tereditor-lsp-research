+    const content = (
+      <TearsheetContext.Provider
+        value={{
+          fullyCollapsed,
+          setFullyCollapsed,
+          onClose,
+          disableHeaderCollapse,
+          setDisableHeaderCollapse,
+          variant,
+          isSm,
+          decorator,
+          titleId: titleId.current,
+        }}>
