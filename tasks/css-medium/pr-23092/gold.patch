+          `${influencerWidth}`
+        );
+      }
+      if (summaryContentWidth) {
+        document.documentElement.style.setProperty(
+          '--tearsheet-summary-content-width',
+          `${summaryContentWidth}`
+        );
+      }
+      if (verticalGap) {
+        document.documentElement.style.setProperty(
+          '--tearsheet-vertical-gap',
+          `${verticalGap}`
+        );
+      }
