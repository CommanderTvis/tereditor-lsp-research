+$block-class: cds--tearsheet;
+
+@mixin hide-at-large-screens() {
+  @include hide-at-lg;
+  @include hide-at-md;
+  @include hide-at-xlg;
+  @include hide-at-max;
+}
+
+// ── WithCustomFooterActions story ────────────────────────────────────────────
+.default__action-buttons {
+  display: grid;
+  grid-auto-rows: minmax(auto, auto);
+  grid-template-columns: repeat(6, 1fr);
+
+  > button {
+    inline-size: 100%;
+    max-inline-size: none;
+  }
+
+  :first-child {
+    grid-column: span 4;
+  }
+}
+
+// ── Panel trigger buttons (summary / influencer) ─────────────────────────────
+.summaryPanelTrigger,
+.influencerPanelTrigger {
+  > button {
+    position: absolute;
+    inset-block-start: 0;
+    inset-inline-end: 0;
+  }
+
+  margin-block-end: $spacing-03;
+}
+
+.influencerPanelTrigger {
+  > button {
+    position: absolute;
+    inset-block-start: 0;
+    inset-inline-start: 0;
+  }
+
+  margin-block-end: $spacing-03;
+}
+
+// On large screens the tearsheet shows panels inline — hide the mobile triggers
+.#{$block-class}:not(.#{$block-class}--narrow) {
+  .summaryPanelTrigger,
+  .influencerPanelTrigger {
+    @include hide-at-large-screens();
+  }
+}
+
+// ── Summary / influencer / main content padding ──────────────────────────────
+.summaryPanelHeading {
+  @include type.type-style('heading-03');
+}
+
+.#{$block-class}__influencer,
+.#{$block-class}__main-content,
+.#{$block-class}__summary-content {
+  padding-block: $spacing-07;
+}
+
+// ── StackingTearsheet story — open-buttons overlay ───────────────────────────
+.stackButtons {
+  position: absolute;
+  z-index: 9999;
+  display: flex;
+  gap: $spacing-01;
+  inset-block-start: 0;
+  inset-inline-start: 0;
+
+  @include hide-at-sm;
+}
+
+.smallScreenButton {
+  position: absolute;
+  z-index: 9999;
+  display: flex;
+  gap: $spacing-01;
+  inset-block-start: 0;
+  inset-inline-start: $spacing-05;
+
+  @include hide-at-large-screens();
+}
+
+// ── WithSteps story — step form layout ───────────────────────────────────────
+.step-container {
+  padding-block: $spacing-06;
+}
+
+.step-heading {
+  margin-block-end: $spacing-05;
+}
+
+.step-form-items {
+  display: flex;
+  flex-direction: column;
+  gap: $spacing-05;
+}
