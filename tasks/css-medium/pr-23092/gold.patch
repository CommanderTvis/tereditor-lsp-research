+  HTMLDivElement,
+  TearsheetProps & {
+    isExiting?: boolean;
+    presenceRef?: RefObject<HTMLDivElement | null>;
+  }
+>(
+  (
+    {
+      children,
+      variant = 'wide',
+      selectorsFloatingMenus = [],
+      className,
+      influencerWidth,
+      summaryContentWidth,
+      ariaLabel,
+      onClose,
+      selectorPrimaryFocus,
+      open = false,
+      portalTarget,
+      disablePortal = false,
+      verticalGap,
+      containerClassName,
+      keepMounted = false,
+      isExiting = false,
+      presenceRef,
+      decorator,
+      launcherButtonRef,
+      ...rest
+    },
+    ref: ForwardedRef<HTMLDivElement>
+  ) => {
