+
+      await waitFor(() => {
+        expect(screen.queryByRole('grid', { name: 'Calendar' })).toBe(null);
+      });
+
+      // Step 3: Click the start input again — calendar should reopen
+      await user.click(startInput);
+
+      await waitFor(() => {
+        expect(screen.getByRole('grid', { name: 'Calendar' })).toBeTruthy();
+      });
+    });
+  });
+});
