+// LICENSE file in the root directory of this source tree.
+//
+
+@use '@carbon/styles/scss/components/date-picker/date-picker' as *;
+@use '@carbon/styles/scss/components/date-picker/date-picker-next' as
+  date-picker-next;
+@use '@carbon/styles/scss/config' as *;
+@use '@carbon/styles/scss/spacing' as *;
+@use '@carbon/styles/scss/theme' as *;
+@use '@carbon/styles/scss/utilities' as *;
+
+@include date-picker;
+@include date-picker-next.date-picker-next-rules;
+
+// =============================================================================
+// WEB COMPONENTS SPECIFIC STYLES
+// These styles add :host() selectors and ::slotted() for shadow DOM
+// =============================================================================
+
+:host(#{$prefix}-preview-date-picker) {
+  @extend .#{$prefix}--date-picker;
+
+  position: relative;
+}
+
+:host(#{$prefix}-preview-date-picker-input),
+:host(#{$prefix}-preview-date-picker-input-skeleton) {
+  @extend .#{$prefix}--date-picker-container;
+}
+
+:host(#{$prefix}-preview-date-picker-input[warn]:not([invalid])) {
+  @extend .#{$prefix}--date-picker-container--warn;
+}
+
+:host(#{$prefix}-preview-date-picker-input[kind='simple']),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='simple']) {
+  @extend .#{$prefix}--date-picker-container--simple;
+}
+
+:host(#{$prefix}-preview-date-picker-input[kind='simple'][short]),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='simple'][short]) {
+  @extend .#{$prefix}--date-picker-container--simple;
+  @extend .#{$prefix}--date-picker-container--short;
+}
+
+:host(#{$prefix}-preview-date-picker-input[kind='single']),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='single']) {
+  @extend .#{$prefix}--date-picker-container--single;
+}
+
+:host(#{$prefix}-preview-date-picker-input[kind='from']),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='from']) {
+  @extend .#{$prefix}--date-picker-container--from;
+}
+
+:host(#{$prefix}-preview-date-picker-input[kind='from']),
+:host(#{$prefix}-preview-date-picker-input[kind='to']),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='from']),
+:host(#{$prefix}-preview-date-picker-input-skeleton[kind='to']) {
+  @extend .#{$prefix}--date-picker-container--from;
+}
+
+:host(#{$prefix}-preview-date-picker-input) {
+  .#{$prefix}--date-picker__icon {
+    @extend .#{$prefix}--date-picker__icon;
+  }
+
+  .#{$prefix}--date-picker__icon--warn {
+    @extend .#{$prefix}--date-picker__icon--warn;
+  }
+
+  .#{$prefix}--date-picker__icon--invalid {
+    @extend .#{$prefix}--date-picker__icon--invalid;
+  }
+
+  // Shadow DOM slotted content
+  ::slotted(#{$prefix}-ai-label),
+  ::slotted(#{$prefix}-slug) {
+    position: absolute;
+    inset-block-start: 50%;
+    inset-inline-end: $spacing-08;
+  }
+
+  ::slotted(#{$prefix}-ai-label:not([revert-active])),
+  ::slotted(#{$prefix}-slug:not([revert-active])) {
+    transform: translateY(-50%);
+  }
+}
+
+:host(#{$prefix}-preview-date-picker-input-skeleton) {
+  @extend .#{$prefix}--date-picker-input-skeleton;
+}
+
+:host(#{$prefix}-preview-date-picker-input-skeleton[range]) {
+  @extend .#{$prefix}--date-picker-input-skeleton--range;
+}
+
+:host(#{$prefix}-preview-date-picker-input[ai-label]) {
+  @extend .#{$prefix}--date-picker-container--ai-label;
+}
+
+// Calendar component in shadow DOM
+:host(#{$prefix}-preview-date-picker-calendar) {
+  display: block;
+  outline: none;
+
+  .#{$prefix}--date-picker__calendar {
+    // Override shared styles for Web Components
+    // Use box-sizing to include padding in width calculation
+    // This ensures the 288px includes the padding, making the content area 272px
+    box-sizing: border-box;
+    inline-size: rem(288px);
+    max-inline-size: rem(288px);
+  }
+
+  .#{$prefix}--date-picker__day,
+  .#{$prefix}--date-picker__month-nav {
+    font-family: inherit;
+  }
+}
