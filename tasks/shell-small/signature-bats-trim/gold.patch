diff --git a/lib/bats-core/common.bash b/lib/bats-core/common.bash
index 2bd1a5b..3acf1e1 100644
--- a/lib/bats-core/common.bash
+++ b/lib/bats-core/common.bash
@@ -207,11 +207,11 @@ bats_any_in() { # <sorted-array> <sorted search values>
   return 1
 }
 
-bats_trim() {                                            # <output-variable> <string>
-  local -r bats_trim_ltrimmed=${2#"${2%%[![:space:]]*}"} # cut off leading whitespace
+bats_trim() {                                            # <string> <output-variable>
+  local -r bats_trim_ltrimmed=${1#"${1%%[![:space:]]*}"} # cut off leading whitespace
   # shellcheck disable=SC2034 # used in eval!
   local -r bats_trim_trimmed=${bats_trim_ltrimmed%"${bats_trim_ltrimmed##*[![:space:]]}"} # cut off trailing whitespace
-  eval "$1=\$bats_trim_trimmed"
+  eval "$2=\$bats_trim_trimmed"
 }
 
 # a helper function to work around unbound variable errors with ${arr[@]} on Bash 3
diff --git a/libexec/bats-core/bats-gather-tests b/libexec/bats-core/bats-gather-tests
index 6a3d836..e819cd4 100755
--- a/libexec/bats-core/bats-gather-tests
+++ b/libexec/bats-core/bats-gather-tests
@@ -21,7 +21,7 @@ read_tags() {
   read -ra tags <<<"$1" || true
   if ((${#tags[@]} > 0)); then
     for ((i = 0; i < ${#tags[@]}; ++i)); do
-      bats_trim "tags[$i]" "${tags[$i]}"
+      bats_trim "${tags[$i]}" "tags[$i]"
     done
     bats_sort sorted_tags "${tags[@]}"
     # shellcheck disable=SC2154
@@ -144,7 +144,7 @@ function should_skip_because_of_filter_tags() {
       IFS=, read -ra filter_tags <<<"$filter_tags" || true
       for filter_tag in "${filter_tags[@]}"; do
         if [[ $filter_tag == !* ]]; then
-          bats_trim filter_tag "${filter_tag#!}"
+          bats_trim "${filter_tag#!}" filter_tag
           negative_filter_tags+=("${filter_tag}")
         else
           positive_filter_tags+=("${filter_tag}")
diff --git a/libexec/bats-core/bats-preprocess b/libexec/bats-core/bats-preprocess
