+  size_t lo = 0;
+  size_t hi = sizeof(wide_cp_ranges) / sizeof(wide_cp_range);
+  while (lo < hi) {
+    size_t mid = lo + (hi - lo) / 2;
+    if (cp < wide_cp_ranges[mid].first)
+      hi = mid;
+    else if (cp > wide_cp_ranges[mid].last)
+      lo = mid + 1;
+    else
+      return 2;
+  }
+  return 1;
 }
 
