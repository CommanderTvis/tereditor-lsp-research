#!/bin/sh
# The study driver. Host requirements: POSIX sh and a container runtime (Docker, or Apple `container` on macOS); on a
# Linux host without one, the native backend (run as root) bootstraps its own pinned Nix. Every command runs the
# scripts in harness/env in the study's Nix environment (nix/flake.nix).
#
#   ./study setup [group ...]          tereditor from its pinned image; the language servers of the groups (default: all)
#   ./study project <project> [commit...]  snapshot, server preparation and grading dependencies of projects
#   ./study probe <project> [arm]      the language server on this project, no model (results/probe/)
#   ./study redteam                    attacks the agent's sandbox from inside: network, gold files, history (no model)
#   ./study validate <project> ...     every task: starting state fails, reference solution passes, twice
#   ./study plan <plan> [options]      results/<plan>/plan.tsv in a seeded random order (analysis/plan.sh)
#   ./study run <plan> [-j N] [--project P]     run the pending lines of a plan, N at a time (default 2)
#   ./study grade <plan> [-j N] [--project P]   grade the finished, ungraded runs
#   ./study review <plan> [-j N] [--project P]  the Haiku quality review of finished edit runs (harness/judge/)
#   ./study analyze <plan>             results/<plan>/report/
#   ./study status <plan>              per project: runs planned, finished, graded
#   ./study archive <plan> <project>   pack a project's runs into results/<plan>/archive/; restore <plan> unpacks all
#   ./study prune <project> ...        drop a finished project's snapshot and caches
#   ./study cloud launch|status|collect <plan> ...  one helper cloud session per project, results through an S3
#                                      bucket of the operator's (docs/CLOUD_PARALLEL.md); cloud scan <archive>...
#   ./study data pull [plan]           fetch results/ (all plans, or one) from the data branch: results never live in
#   ./study data push <plan>           this branch; they are published on gh-pages under data/results/ (README.md)
#
# Environment: STUDY_RUNTIME=docker|container|native, STUDY_CPUS (default 4), STUDY_MEMORY (default 8g) per container
# (a container holds all parallel runs of a language group: size it for -j runs),
# ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN (or STUDY_ENV_FILE, default ./study.env).
set -eu
ROOT=$(cd "$(dirname "$0")" && pwd)
cd "$ROOT"

die() { echo "study: $*" >&2; exit 2; }
log() { echo "[study $(date -u +%H:%M:%S)] $*" >&2; }

if [ -z "${STUDY_RUNTIME:-}" ]; then
  if command -v docker >/dev/null 2>&1; then STUDY_RUNTIME=docker
  elif command -v container >/dev/null 2>&1; then STUDY_RUNTIME=container
  elif [ "$(uname -s)" = Linux ]; then STUDY_RUNTIME=native
  else case "${1:-}" in cloud|data) ;; *) die "need Docker or Apple container" ;; esac; fi   # cloud and data need none
fi
RT=${STUDY_RUNTIME:-}
# An amd64 builder on an arm64 host (DOCKER_DEFAULT_PLATFORM=linux/amd64, needed for clangd) keeps its own volume pair:
# a Nix store holds one architecture's paths, and the image's /bin/sh points into it.
VSUF=; case "${DOCKER_DEFAULT_PLATFORM:-}" in *amd64*|*x86_64*) VSUF=-amd64 ;; esac
CPUS=${STUDY_CPUS:-4}
MEMORY=${STUDY_MEMORY:-8g}
NIX_IMAGE=docker.io/nixos/nix:2.35.6@sha256:b49cb33f3a7e5cf3933ad8774529de0e3807ec5cf54987aa7ccdfb49f2fc55ed
GROUPS_ALL="python typescript csharp php jvm cpp shell css"

# The language group of a project: its toolchain and language servers.
group_of() { l=${1%-*}; case "$l" in kotlin|java|java-kotlin) echo jvm ;; *) echo "$l" ;; esac; }

# Credentials and the JetBrains licence, passed to the environment by variable name only.
load_credentials() {
  envf=${STUDY_ENV_FILE:-$ROOT/study.env}
  if [ -z "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -f "$envf" ]; then
    ANTHROPIC_API_KEY=$(sed -n 's/^ANTHROPIC_API_KEY=//p' "$envf" | tr -d '"'"'"' \r')
    CLAUDE_CODE_OAUTH_TOKEN=$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' "$envf" | tr -d '"'"'"' \r')
  fi
  # In a Claude Code cloud session the session's own login (a token file) is used; nothing has to be set.
  [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ -s /home/claude/.claude/remote/.oauth_token ] \
    || die "set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN, or put one in $envf"
  export ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
}
load_license() {
  lic=""; for f in "$ROOT/license.zip" "$ROOT/license.txt"; do [ -f "$f" ] && { lic=$f; break; }; done
  [ -n "$lic" ] || die "no JetBrains licence: put license.zip (or license.txt) in $ROOT, see README.md"
  STUDY_LICENSE_ZIP_B64=$(base64 < "$lic" | tr -d '\n')
  case "$lic" in *.zip) STUDY_LICENSE_NAME=license.zip ;; *) STUDY_LICENSE_NAME=license.txt ;; esac
  export STUDY_LICENSE_ZIP_B64 STUDY_LICENSE_NAME
}

# --- backends -------------------------------------------------------------------------------------------------------

# Container backends: the pinned nixos/nix image with two volumes, the Nix store (study-nix, initialised from the
# image once) and the state (study-state: tereditor, caches, snapshots); this repository is mounted at /study-root.
# bubblewrap inside needs the capabilities to create namespaces.
priv() { if [ "$RT" = docker ]; then echo --privileged; else echo "--cap-add ALL"; fi; }
ctr_volumes() {
  container_lock
  if [ "$RT" = docker ]; then
    docker volume inspect study-nix$VSUF >/dev/null 2>&1 || docker volume create study-nix$VSUF >/dev/null
    docker volume inspect study-state$VSUF >/dev/null 2>&1 || docker volume create study-state$VSUF >/dev/null
  else
    container volume inspect study-nix$VSUF >/dev/null 2>&1 || container volume create study-nix$VSUF >/dev/null
    container volume inspect study-state$VSUF >/dev/null 2>&1 || container volume create study-state$VSUF >/dev/null
  fi
  if ! $RT run --rm -v study-nix$VSUF:/nix --entrypoint /bin/sh "$NIX_IMAGE" -c 'test -x /nix/var/nix/profiles/default/bin/nix' >/dev/null 2>&1; then
    log "initialising the Nix store volume"
    $RT run --rm -v study-nix$VSUF:/mnt --entrypoint /bin/sh "$NIX_IMAGE" -c 'cp -a /nix/. /mnt/'
  fi
}

# Native backend: a Linux host, as root, with the pinned Nix release unpacked into /nix (no daemon, nothing else
# installed). STUDY_STATE defaults to /var/lib/study.
NIX_VERSION=2.35.6
nix_sha256() { case "$1" in x86_64) echo b12ab64a291e41846b9da37b7f56eafa7683deaa267bafb2ed43440ab2f45f13 ;;
                             aarch64) echo 1f177b572baadf8c09750028f047fe943a3615a34f3e4a43927367a1e0120801 ;; esac; }
native_nix() {
  [ "$(id -u)" = 0 ] || die "the native backend runs as root"
  command -v nix >/dev/null 2>&1 && return 0
  [ -x /nix/var/study-nix/bin/nix ] && { PATH=/nix/var/study-nix/bin:$PATH; return 0; }
  a=$(uname -m); t=$(mktemp -d)
  log "installing the pinned Nix $NIX_VERSION into /nix"
  curl -fsSL -o "$t/nix.tar.xz" "https://releases.nixos.org/nix/nix-$NIX_VERSION/nix-$NIX_VERSION-$a-linux.tar.xz"
  echo "$(nix_sha256 "$a")  $t/nix.tar.xz" | sha256sum -c - >/dev/null || die "Nix download checksum mismatch"
  tar -xJf "$t/nix.tar.xz" -C "$t"; d=$(echo "$t"/nix-*-linux)
  mkdir -p /nix/store /nix/var/study-nix/bin && cp -a "$d"/store/* /nix/store/
  n=$(ls -d /nix/store/*-nix-"$NIX_VERSION" | head -n1)
  "$n/bin/nix-store" --load-db < "$d/.reginfo"
  ln -sf "$n/bin/nix" "$n/bin/nix-store" /nix/var/study-nix/bin/
  PATH=/nix/var/study-nix/bin:$PATH; rm -rf "$t"
}

# Apple container attaches a volume to one container at a time, so with it every environment command waits for the
# previous one (several agents can share the repository). The lock is released when this process exits.
container_lock() {
  [ "$RT" = container ] || return 0
  [ "${STUDY_LOCK_HELD:-}" = 1 ] && return 0
  lock=$ROOT/.study-lock
  until mkdir "$lock" 2>/dev/null; do
    if [ -f "$lock/pid" ] && ! kill -0 "$(cat "$lock/pid")" 2>/dev/null; then rm -rf "$lock"; continue; fi
    sleep 5
  done
  echo $$ > "$lock/pid"; STUDY_LOCK_HELD=1; export STUDY_LOCK_HELD
  trap 'rm -rf "$lock"' EXIT INT TERM
}

# env_run <group> <script> [args...]: one harness script in the environment of a language group.
env_run() {
  g=$1; shift
  if [ "$RT" = native ]; then
    native_nix
    STUDY_ROOT=$ROOT STUDY_STATE=${STUDY_STATE:-/var/lib/study} sh "$ROOT/harness/env/entry.sh" "$g" "$@"
  else
    container_lock
    $RT run --rm $(priv) --cpus "$CPUS" --memory "$MEMORY" \
      -v study-nix$VSUF:/nix -v study-state$VSUF:/state -v "$ROOT:/study-root" \
      -e "STUDY_HOST_UID=$(id -u)" -e "STUDY_HOST_GID=$(id -g)" -e POLL_S \
      ${ANTHROPIC_API_KEY:+-e ANTHROPIC_API_KEY} ${CLAUDE_CODE_OAUTH_TOKEN:+-e CLAUDE_CODE_OAUTH_TOKEN} \
      ${STUDY_LICENSE_ZIP_B64:+-e STUDY_LICENSE_ZIP_B64 -e STUDY_LICENSE_NAME} \
      --entrypoint /bin/sh "$NIX_IMAGE" /study-root/harness/env/entry.sh "$g" "$@"
  fi
}

# --- commands -------------------------------------------------------------------------------------------------------

cmd_setup() {
  [ "$RT" = native ] || ctr_volumes
  for g in ${*:-$GROUPS_ALL}; do env_run "$g" setup; done
}

cmd_project() {
  # ./study project <project> <40-hex commit>...: only those commits (default: the pinned one and every task's base commit)
  case "${2:-}" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*)
    [ -f "projects/$1/project.toml" ] || die "no projects/$1"; p=$1; shift; env_run "$(group_of "$p")" project "$p" "$@"; return ;; esac
  for p in "$@"; do [ -f "projects/$p/project.toml" ] || die "no projects/$p"; env_run "$(group_of "$p")" project "$p"; done
}

cmd_probe() {
  p=$1 mode=${2:-enforced}; load_license
  out=results/probe/$p-$mode; rm -rf "$out"; mkdir -p "$out"
  r=/study-root; [ "$RT" = native ] && r=$ROOT
  env_run "$(group_of "$p")" probe "$p" "$mode" "$r/$out" "$r/projects/$p/probe.json"
  log "probe results: $out/probe.jsonl"
}

cmd_redteam() { env_run python redteam; }

cmd_validate() { for p in "$@"; do env_run "$(group_of "$p")" validate "$p"; done; }

cmd_plan() { name=$1; shift; mkdir -p "results/$name"; env_run python plan "$name" "$@"
             log "wrote results/$name/plan.tsv ($(($(wc -l < "results/$name/plan.tsv") - 1)) runs)"; }

plan_ids() { awk -F'\t' -v p="${2:-}" 'NR>1 && (p=="" || $2==p) {print $1}' "results/$1/plan.tsv"; }
parse_jp() { j=2; only=""; while [ $# -gt 0 ]; do case "$1" in -j) j=$2; shift 2 ;; --project) only=$2; shift 2 ;; *) die "unknown option $1" ;; esac; done; }

# The runs (or gradings) of a plan go to one environment per language group, N at a time inside it.
by_group() { # <run|grade> <plan>
  what=$1 plan=$2
  ids=$(plan_ids "$plan" "$only" | while read -r r; do
    f=results/$plan/runs/$r
    if [ "$what" = run ]; then [ -f "$f/exit.json" ] || echo "$r"
    elif [ "$what" = review ]; then if [ -f "$f/exit.json" ] && [ ! -f "$f/review/result.json" ]; then echo "$r"; fi
    elif [ -f "$f/exit.json" ] && [ ! -f "$f/grade/result.json" ]; then echo "$r"; fi
  done)
  [ -n "$ids" ] || { log "nothing to $what"; return 0; }
  for g in $(for r in $ids; do group_of "$(awk -F'\t' -v r="$r" '$1==r {print $2}' "results/$plan/plan.tsv")"; done | sort -u); do
    sel=$(for r in $ids; do [ "$(group_of "$(awk -F'\t' -v r="$r" '$1==r {print $2}' "results/$plan/plan.tsv")")" = "$g" ] && echo "$r"; done; true)
    env_run "$g" run-many "$what" "$plan" "$j" $sel
  done
}

# A usage or rate limit (a Max plan's 5-hour window, an API quota) pauses the run, it does not end it: runs that stopped on
# one are discarded and retried once the limit has reset (the marker holds the seconds until then, from the run's stream;
# LIMIT_WAIT_S, default 1800, when it does not say; tried again until the window has reset).
cmd_run() {
  plan=$1; shift; parse_jp "$@"; load_credentials; load_license
  [ "$RT" = native ] || ctr_volumes
  while :; do
    rm -f "results/$plan/.limit"
    by_group run "$plan"
    [ -f "results/$plan/.limit" ] || break
    wait=$(cat "results/$plan/.limit" 2>/dev/null); case "$wait" in ''|*[!0-9]*) wait=${LIMIT_WAIT_S:-1800} ;; esac
    log "usage limit reached; waiting $wait s, then retrying the unfinished runs"
    sleep "$wait"
  done
}
cmd_grade() { plan=$1; shift; parse_jp "$@"; by_group grade "$plan"; }
# The post-hoc quality review of edit runs (docs/ANALYSIS_PLAN.md, outcome 3; harness/judge/prompt.md).
cmd_review() { plan=$1; shift; parse_jp "$@"; load_credentials; by_group review "$plan"; }

cmd_analyze() { env_run python analyze "$1"; }

cmd_status() {
  P=results/$1
  printf '%-22s %7s %8s %7s\n' project planned finished graded
  awk -F'\t' 'NR>1 {print $1"\t"$2}' "$P/plan.tsv" | while IFS="$(printf '\t')" read -r rid proj; do
    f=0; g=0; [ -f "$P/runs/$rid/exit.json" ] && f=1; [ -f "$P/runs/$rid/grade/result.json" ] && g=1
    printf '%s\t%s\t%s\n' "$proj" "$f" "$g"
  done | awk -F'\t' '{n[$1]++; f[$1]+=$2; g[$1]+=$3} END {for (p in n) printf "%-22s %7d %8d %7d\n", p, n[p], f[p], g[p]}' | sort
}

cmd_archive() {
  plan=$1 proj=$2; P=results/$plan; mkdir -p "$P/archive"
  ids=$(plan_ids "$plan" "$proj" | while read -r r; do if [ -f "$P/runs/$r/exit.json" ]; then echo "$r"; fi; done)
  [ -n "$ids" ] || { log "archive: no finished runs for $proj"; return 0; }
  (cd "$P/runs" && tar -czf "../archive/$proj.tar.gz" $ids)
  log "archived $(echo "$ids" | wc -l | tr -d ' ') runs of $proj: $(du -h "$P/archive/$proj.tar.gz" | cut -f1)"
}
cmd_restore() {
  P=results/$1; mkdir -p "$P/runs"
  for a in "$P"/archive/*.tar.gz; do [ -f "$a" ] && tar -xzf "$a" -C "$P/runs"; done
  log "restored: $(ls "$P/runs" | wc -l | tr -d ' ') run directories"
}

cmd_prune() {
  for p in "$@"; do env_run "$(group_of "$p")" prune "$p"; done
}

# --- cloud: one helper cloud session per project (docs/CLOUD_PARALLEL.md) ---------------------------------------------

# The operator's bucket, from cloud.env (git-ignored): S3_ENDPOINT, S3_REGION, S3_ACCESS, S3_SECRET.
cloud_env() {
  f=${STUDY_CLOUD_ENV:-$ROOT/cloud.env}
  [ -f "$f" ] || die "no $f: put S3_ENDPOINT, S3_REGION, S3_ACCESS and S3_SECRET of your bucket in it (docs/CLOUD_PARALLEL.md)"
  for v in S3_ENDPOINT S3_REGION S3_ACCESS S3_SECRET; do
    val=$(sed -n "s/^$v=//p" "$f" | tail -n1 | tr -d '"'"'"' \r')
    [ -n "$val" ] || die "$f has no $v (docs/CLOUD_PARALLEL.md)"
    eval "$v=\$val"
  done
  S3_ENDPOINT=${S3_ENDPOINT%/}; export S3_ENDPOINT S3_REGION S3_ACCESS S3_SECRET
  . "$ROOT/harness/cloud/s3.sh"
  s3_check || die "cloud: the S3 helper needs curl 7.75 or later"
}
cloud_dry() { [ -n "${STUDY_CLOUD_DRY_RUN:-}" ]; }
# The projects of a plan in the order of their first run, without postponed, skipped or dropped ones.
cloud_projects() {
  awk -F'\t' 'NR>1 && !s[$2]++ {print $2}' "results/$1/plan.tsv" | while read -r p; do
    case "$(sed -n 's/^status[[:space:]]*=[[:space:]]*"\([a-z]*\)".*/\1/p' "projects/$p/project.toml" 2>/dev/null | head -n1)" in
      postponed|skipped|dropped) ;; *) echo "$p" ;; esac
  done
}
# cloud_status <plan> <project>: the project's status.json in the bucket (empty if none; nothing in a dry run).
cloud_status() { if cloud_dry; then return 0; fi; s3_try "$1/$2/status.json" || true; }
# The last session id launched for a project, from results/<plan>/cloud/sessions.tsv.
cloud_session() { awk -F'\t' -v p="$2" '$1==p && $2!="NONE" {s=$2} END {if (s) print s}' "results/$1/cloud/sessions.tsv" 2>/dev/null || true; }
cloud_url() { echo "https://claude.ai/code/$1"; }
iso_epoch() { date -u -d "$1" +%s 2>/dev/null || date -ju -f %Y-%m-%dT%H:%M:%SZ "$1" +%s 2>/dev/null || true; }
shquote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# cloud_prompt <plan> <project> [mask]: harness/cloud/prompt.tmpl filled in (literal replacement: a key may hold / or &).
cloud_prompt() {
  a=$S3_ACCESS s=$S3_SECRET; [ "${3:-}" = mask ] && { a='<S3_ACCESS>'; s='<S3_SECRET>'; }
  CP_PLAN=$1 CP_PROJECT=$2 CP_ENDPOINT=$S3_ENDPOINT CP_REGION=$S3_REGION CP_ACCESS=$a CP_SECRET=$s awk '
    function rep(t, k, v,   i, o) { o = ""; while ((i = index(t, k)) > 0) { o = o substr(t, 1, i - 1) v; t = substr(t, i + length(k)) } return o t }
    { l = $0
      l = rep(l, "__PROJECT__", ENVIRON["CP_PROJECT"]); l = rep(l, "__PLAN__", ENVIRON["CP_PLAN"])
      l = rep(l, "__ENDPOINT__", ENVIRON["CP_ENDPOINT"]); l = rep(l, "__REGION__", ENVIRON["CP_REGION"])
      l = rep(l, "__ACCESS__", ENVIRON["CP_ACCESS"]); l = rep(l, "__SECRET__", ENVIRON["CP_SECRET"])
      print l }' "$ROOT/harness/cloud/prompt.tmpl"
}

# cloud_launch_one <plan> <project>: one helper session. `claude --cloud` refuses without a terminal, so `script` gives it
# a pty; with stdin at EOF the client detaches once it has printed "Created cloud session: ... session_...". It runs from
# this repository's root (an untrusted directory stops at the folder-trust dialog), and the prompt directly follows
# --cloud. The cloud environment is the one selected with /remote-env. The filled prompt and the pty log (which may echo
# the prompt) stay in a private temporary directory and are deleted; only the session id is kept.
cloud_launch_one() {
  plan=$1 p=$2
  t=$(mktemp -d "${TMPDIR:-/tmp}/study-cloud.XXXXXX"); chmod 700 "$t"
  pf=$t/prompt.txt tty=$t/tty.log name="lsp-study $plan $p"
  (umask 077; if cloud_dry; then cloud_prompt "$plan" "$p" mask; else cloud_prompt "$plan" "$p"; fi > "$pf")
  inner="claude --model $(shquote "$CL_MODEL") --permission-mode $(shquote "$CL_PERM") -n $(shquote "$name") --cloud \"\$(cat $(shquote "$pf"))\""
  if [ "$(uname -s)" = Linux ]; then set -- script -qec "$inner" "$tty"; shown="script -qec $(shquote "$inner") $tty"   # util-linux
  else set -- script -q "$tty" claude --model "$CL_MODEL" --permission-mode "$CL_PERM" -n "$name" --cloud "$(cat "$pf")"
       shown="script -q $tty $inner"; fi                                                                        # BSD, macOS
  if cloud_dry; then
    echo "dry run: launch $p (from $ROOT):"; echo "  $shown </dev/null >/dev/null 2>&1"
    echo "  prompt ($pf, keys masked):"; sed 's/^/  | /' "$pf"
    rm -rf "$t"; return 0
  fi
  "$@" </dev/null >/dev/null 2>&1 || true
  sid=$(LC_ALL=C grep -ao 'session_[A-Za-z0-9]*' "$tty" | head -n1 || true)
  printf '%s\t%s\t%s\n' "$p" "${sid:-NONE}" "$(date -u +%FT%TZ)" >> "results/$plan/cloud/sessions.tsv"
  if [ -n "$sid" ]; then rm -rf "$t"; log "launched $p: $(cloud_url "$sid")"
  else log "launch of $p printed no session id; its pty log is $tty (it may hold the S3 key: delete it after reading)"; fi
}

# A project's step is model-heavy (its helper session takes turns, its runs call the model) until it reaches grading.
# A launched project without a status yet is heavy too: its session needs minutes to start the worker.
cloud_heavy() { # <status json>
  case "$(printf '%s' "$1" | json_field state)" in done|incomplete|failed|skipped) return 1 ;; esac
  case "$(printf '%s' "$1" | json_field step)" in grade|review|archive|upload|finished) return 1 ;; esac
  return 0
}

cmd_cloud_launch() {
  plan=${1:-}; [ -n "$plan" ] || die "usage: ./study cloud launch <plan> [--projects \"p ...\"] [--max-running N] [--model M] [--permission-mode M]"
  shift; sel=""; n=4; CL_MODEL=sonnet; CL_PERM=auto
  while [ $# -gt 0 ]; do case "$1" in
    --projects) sel=$2; shift 2 ;; --max-running) n=$2; shift 2 ;; --model) CL_MODEL=$2; shift 2 ;;
    --permission-mode) CL_PERM=$2; shift 2 ;; *) die "unknown option $1" ;; esac; done
  case "$n" in ''|*[!0-9]*|0) die "--max-running needs a positive number" ;; esac
  # Every refusal comes before any network call.
  cloud_env
  pl=results/$plan/plan.tsv
  [ -f "$pl" ] || die "no $pl: ./study data pull $plan, or ./study plan $plan ... (and ./study data push $plan to publish it)"
  [ -f "$ROOT/license.zip" ] || die "no license.zip (the JetBrains offline activation code) in $ROOT, see README.md"
  branch=$(git symbolic-ref --short -q HEAD) || die "detached HEAD: check out the branch the helpers should clone"
  [ -z "$(git status --porcelain -- study harness analysis projects tasks nix)" ] \
    || log "warning: uncommitted changes in the harness, projects or tasks are not in the bundle the helpers clone"
  cloud_dry || command -v claude >/dev/null 2>&1 || die "claude (Claude Code) is not on PATH"
  all=$(cloud_projects "$plan")
  if [ -n "$sel" ]; then
    for p in $sel; do case " $(echo $all) " in *" $p "*) ;; *) die "$p is not a (non-postponed) project of $pl" ;; esac; done
  fi
  cloud_dry || { mkdir -p "results/$plan/cloud"; touch "results/$plan/cloud/sessions.tsv"; }

  # The control files every helper reads.
  t=$(mktemp -d "${TMPDIR:-/tmp}/study-cloud.XXXXXX")
  git bundle create -q "$t/study.bundle" "$branch" 2>/dev/null || git bundle create "$t/study.bundle" "$branch"
  echo "$branch" > "$t/branch.txt"; sha256_of "$pl" > "$t/plan.sha256"
  for kv in "$ROOT/license.zip=control/license.zip" "$t/study.bundle=control/study.bundle" "$t/branch.txt=control/branch.txt" \
            "$pl=control/plan.tsv" "$t/plan.sha256=control/plan.sha256" "$ROOT/harness/cloud/child.sh=control/child.sh" "$ROOT/harness/cloud/s3.sh=control/s3.sh"; do
    if cloud_dry; then echo "dry run: upload ${kv%%=*} to ${kv#*=}"
    else s3_put "${kv%%=*}" "${kv#*=}" || die "upload of ${kv#*=} failed"; fi
  done
  log "control files uploaded: branch $branch, plan sha256 $(cat "$t/plan.sha256")"; rm -rf "$t"

  # The queue: the given projects, else those with no status in the bucket and no session launched yet.
  queue=""
  if [ -n "$sel" ]; then queue=$sel
  else for p in $all; do
    if [ -z "$(cloud_status "$plan" "$p")" ] && [ -z "$(cloud_session "$plan" "$p")" ]; then queue="$queue $p"; fi
  done; fi
  [ -n "$(echo $queue)" ] || { log "nothing to launch: every project has a status or a session (./study cloud status $plan)"; return 0; }
  log "to launch, at most $n model-heavy at a time:$queue"

  # The scheduler. All helpers share the operator's Claude plan: when its 5-hour window runs out, the helpers' own turns
  # die, their VMs pause and the workers stop until someone types into each session. So at most N projects are in a
  # model-heavy step at once; the next is launched when one reaches grading or ends. State comes from the bucket and
  # sessions.tsv on every pass, so a restarted launch picks up where it was.
  first=1
  while :; do
    heavy=0
    if cloud_dry; then heavy=$((first == 1 ? 0 : n)); else
      for p in $(cut -f1 "results/$plan/cloud/sessions.tsv" | sort -u); do
        [ -n "$(cloud_session "$plan" "$p")" ] || continue
        if cloud_heavy "$(cloud_status "$plan" "$p")"; then heavy=$((heavy+1)); fi
      done
    fi
    first=0
    while [ "$heavy" -lt "$n" ] && [ -n "$(echo $queue)" ]; do
      set -- $queue; p=$1; shift; queue="$*"
      cloud_launch_one "$plan" "$p"; heavy=$((heavy+1))
      [ -z "$queue" ] || cloud_dry || sleep "${STUDY_CLOUD_LAUNCH_GAP_S:-10}"
    done
    [ -n "$queue" ] || break
    if cloud_dry; then echo "dry run: would wait for a free slot before launching: $queue"; return 0; fi
    log "$heavy of $n model-heavy; waiting to launch: $queue"
    sleep "${STUDY_CLOUD_POLL_S:-300}"
  done
  log "all launched; follow them with ./study cloud status $plan, then ./study cloud collect $plan"
}

cmd_cloud_status() {
  plan=${1:-}; [ -n "$plan" ] || die "usage: ./study cloud status <plan>"; [ -f "results/$plan/plan.tsv" ] || die "no results/$plan/plan.tsv"
  cloud_env; cloud_dry && die "status reads the bucket; unset STUDY_CLOUD_DRY_RUN"
  nowe=$(date -u +%s)
  printf '%-20s %-10s %-9s %-26s %-20s %s\n' project state step host time heartbeat
  for p in $(cloud_projects "$plan"); do
    js=$(cloud_status "$plan" "$p"); sid=$(cloud_session "$plan" "$p")
    if [ -z "$js" ]; then
      if [ -n "$sid" ]; then printf '%-20s %-10s (no status yet) %s\n' "$p" launched "$(cloud_url "$sid")"; else printf '%-20s %s\n' "$p" -; fi
      continue
    fi
    state=$(printf '%s' "$js" | json_field state); tm=$(printf '%s' "$js" | json_field time)
    hb=$(s3_try "$plan/$p/heartbeat.txt" | head -n1 || true)
    last=$(printf '%s' "$hb" | cut -d' ' -f1); [ -n "$last" ] || last=$tm
    flag=""
    case "$state" in running|waiting)
      e=$(iso_epoch "$last")
      if [ -n "$e" ] && [ $((nowe - e)) -gt 1500 ]; then flag="  stalled: open ${sid:+$(cloud_url "$sid")}"; [ -n "$sid" ] || flag="$flag(no session recorded)"; fi ;;
    esac
    printf '%-20s %-10s %-9s %-26s %-20s %s%s\n' "$p" "$state" "$(printf '%s' "$js" | json_field step)" \
      "$(printf '%s' "$js" | json_field host)" "$tm" "${hb:--}" "$flag"
    case "$state" in done|incomplete|failed) printf '%-20s   %s\n' "" "$(printf '%s' "$js" | json_field detail)" ;; esac
  done
}

# cloud_scan <archive>: the archive's limit-stopped runs and reviews (harness/cloud/scan.sh); fails if there are any.
cloud_scan() {
  d=$(mktemp -d "${TMPDIR:-/tmp}/study-scan.XXXXXX")
  tar -xzf "$1" -C "$d" || { rm -rf "$d"; echo "unreadable archive"; return 2; }
  rc=0; bash "$ROOT/harness/cloud/scan.sh" "$d" || rc=$?
  rm -rf "$d"; return $rc
}
cmd_cloud_scan() { r=0; for a in "$@"; do printf '%s: ' "$a"; cloud_scan "$a" || r=1; done; return $r; }

# Download the archives of projects that ended done or incomplete and check them; commits nothing.
cmd_cloud_collect() {
  plan=${1:-}; [ -n "$plan" ] || die "usage: ./study cloud collect <plan>"; [ -f "results/$plan/plan.tsv" ] || die "no results/$plan/plan.tsv"
  cloud_env; cloud_dry && die "collect reads the bucket; unset STUDY_CLOUD_DRY_RUN"
  A=results/$plan/archive; mkdir -p "$A"; bad=0; got=0
  for p in $(cloud_projects "$plan"); do
    state=$(cloud_status "$plan" "$p" | json_field state)
    case "$state" in done|incomplete) ;; *) continue ;; esac
    t=$(mktemp -d "${TMPDIR:-/tmp}/study-collect.XXXXXX")
    if ! s3_get "$plan/$p/$p.tar.gz" "$t/$p.tar.gz" || ! tar -tzf "$t/$p.tar.gz" >/dev/null 2>&1; then
      echo "$p: $state, archive missing or unreadable"; bad=$((bad+1)); rm -rf "$t"; continue
    fi
    if s3_try "$plan/$p/limit-attempts.log" > "$t/limit.log" && [ -s "$t/limit.log" ]; then mv "$t/limit.log" "$A/$p.limit-attempts.log"; fi
    mv "$t/$p.tar.gz" "$A/$p.tar.gz"; rm -rf "$t"; got=$((got+1))
    sc=$(cloud_scan "$A/$p.tar.gz") && ok=1 || ok=0
    if [ "$state" = "done" ] && [ "$ok" = 1 ]; then echo "$p: done, $sc: collected clean"
    else echo "$p: $state, $sc: NOT clean (re-run the limit-stopped or missing runs before using it)"; bad=$((bad+1)); fi
  done
  log "collected $got archives into $A; $bad not clean. Nothing is published: review, then ./study data push $plan."
  [ "$bad" = 0 ] || exit 1
}

cmd_cloud() {
  sub=${1:-}; [ $# -gt 0 ] && shift
  case "$sub" in
    launch) cmd_cloud_launch "$@" ;;
    status) cmd_cloud_status "$@" ;;
    collect) cmd_cloud_collect "$@" ;;
    scan) cmd_cloud_scan "$@" ;;
    *) die "usage: ./study cloud launch|status|collect <plan> ..., or cloud scan <archive.tar.gz>... (docs/CLOUD_PARALLEL.md)" ;;
  esac
}

c=${1:-}; [ -n "$c" ] || { sed -n '2,22p' "$0"; exit 2; }; shift
# Results never live in this branch (/results/ is ignored): they are published on a data branch, by default gh-pages
# of origin, under data/results/<plan>/ (plans, archives, reports; never the raw runs/ directories).
DATA_REMOTE=${STUDY_DATA_REMOTE:-origin} DATA_BRANCH=${STUDY_DATA_BRANCH:-gh-pages}
cmd_data() {
  op=${1:-}; plan=${2:-}
  case "$op" in
    pull)
      git fetch -q "$DATA_REMOTE" "$DATA_BRANCH" || die "cannot fetch $DATA_REMOTE $DATA_BRANCH"
      src=data/results${plan:+/$plan}
      git cat-file -e "FETCH_HEAD:$src" 2>/dev/null || die "no $src on $DATA_REMOTE/$DATA_BRANCH"
      git archive --format=tar FETCH_HEAD "$src" | tar -xf - --strip-components=1
      log "pulled $src into ${src#data/}" ;;
    push)
      [ -n "$plan" ] || die "usage: ./study data push <plan>"
      [ -d "results/$plan" ] || die "no results/$plan"
      git fetch -q "$DATA_REMOTE" "$DATA_BRANCH" || die "cannot fetch $DATA_REMOTE $DATA_BRANCH"
      idx=$(mktemp "${TMPDIR:-/tmp}/study-data-index.XXXXXX")
      GIT_INDEX_FILE=$idx git read-tree FETCH_HEAD
      GIT_INDEX_FILE=$idx git rm -r -q --cached --ignore-unmatch "data/results/$plan"
      find "results/$plan" -type f ! -path "results/$plan/runs/*" ! -name '.*' | while IFS= read -r f; do
        GIT_INDEX_FILE=$idx git update-index --add --cacheinfo "100644,$(git hash-object -w "$f"),data/$f"
      done
      tree=$(GIT_INDEX_FILE=$idx git write-tree); rm -f "$idx"
      [ "$tree" != "$(git rev-parse 'FETCH_HEAD^{tree}')" ] || { log "data/results/$plan is already up to date"; return 0; }
      sign=; [ "$(git config --bool commit.gpgsign)" = true ] && sign=-S
      commit=$(git commit-tree $sign "$tree" -p FETCH_HEAD -m "Data: results/$plan") || die "commit failed (signing?)"
      git push -q "$DATA_REMOTE" "$commit:refs/heads/$DATA_BRANCH" || die "push to $DATA_REMOTE $DATA_BRANCH failed"
      log "published results/$plan to $DATA_REMOTE/$DATA_BRANCH as data/results/$plan ($commit)" ;;
    *) die "usage: ./study data pull [plan] | push <plan>" ;;
  esac
}

case "$c" in
  setup) cmd_setup "$@" ;;
  project) cmd_project "$@" ;;
  probe) cmd_probe "$@" ;;
  redteam) cmd_redteam ;;
  validate) cmd_validate "$@" ;;
  plan) cmd_plan "$@" ;;
  run) cmd_run "$@" ;;
  grade) cmd_grade "$@" ;;
  review) cmd_review "$@" ;;
  analyze) cmd_analyze "$@" ;;
  status) cmd_status "$@" ;;
  archive) cmd_archive "$@" ;;
  restore) cmd_restore "$@" ;;
  prune) cmd_prune "$@" ;;
  cloud) cmd_cloud "$@" ;;
  data) cmd_data "$@" ;;
  *) die "unknown command $c" ;;
esac
