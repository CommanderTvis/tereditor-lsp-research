#!/bin/sh
# The study driver. Host requirements: POSIX sh, a container runtime (docker, or Apple `container` on macOS) and an
# Anthropic credential. Everything else (git, jq, toolchains, analysis) runs in containers.
#
#   ./study images [lang ...]          build sharprail, agent, warm-<lang> images
#   ./study project <lang-size> ...    build the run and grade images of projects
#   ./study probe <lang-size> [arm]    scripted LSP probe, no model (results/probe/<project>/)
#   ./study validate <lang-size> ...   grader validity: start state fails, gold passes, twice
#   ./study plan <plan-name> [args]    write results/<plan>/plan.tsv (randomised order), see analysis/plan.sh
#   ./study run <plan-name> [-j N]     run every pending line of the plan, N at a time (default 3)
#   ./study run-one <plan> <run-id>    run one line
#   ./study grade <plan-name> [-j N]   grade every finished, ungraded run
#   ./study analyze <plan-name>        tables and figures into results/<plan>/report/
#
# Environment: STUDY_RUNTIME=docker|container (default: whichever exists), ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN (runs only), STUDY_CPUS (default 4), STUDY_MEMORY (default 6g).
set -eu
ROOT=$(cd "$(dirname "$0")" && pwd)
cd "$ROOT"

if [ -z "${STUDY_RUNTIME:-}" ]; then
  if command -v docker >/dev/null 2>&1; then STUDY_RUNTIME=docker
  elif command -v container >/dev/null 2>&1; then STUDY_RUNTIME=container
  else echo "study: need docker or Apple container" >&2; exit 2; fi
fi
RT=$STUDY_RUNTIME
CPUS=${STUDY_CPUS:-4}
MEMORY=${STUDY_MEMORY:-6g}
SHARPRAIL_COMMIT=$(sed -n 's/^ARG SHARPRAIL_COMMIT=//p' harness/images/sharprail/Dockerfile)
SHARPRAIL_TAG=study/sharprail:$(printf %.7s "$SHARPRAIL_COMMIT")

die() { echo "study: $*" >&2; exit 2; }
log() { echo "[study $(date -u +%H:%M:%S)] $*" >&2; }

# toml_get <file> <key>: a flat `key = "value"` or `key = value` from project.toml / task.toml.
toml_get() { sed -n "s/^$2[[:space:]]*=[[:space:]]*\"\{0,1\}\([^\"]*\)\"\{0,1\}[[:space:]]*\$/\1/p" "$1" | head -n1; }

# One platform for every language: the native one (clangd has a pinned linux/arm64 build since SharpRail 0da30195).
platform_of() { echo "linux/$(native_arch)"; }
native_arch() { case "$(uname -m)" in x86_64|amd64) echo amd64 ;; arm64|aarch64) echo arm64 ;; *) uname -m ;; esac; }
servers_of() { case "$1" in cpp) echo clangd ;; *) echo "$1" ;; esac; }
# The warm image a language runs on: the JVM languages share one (Kotlin server, IntelliJ server, JDK).
warm_of() { case "$1" in kotlin|java|java-kotlin) echo jvm ;; *) echo "$1" ;; esac; }
arch_tag() { echo "$1" | sed 's|linux/||'; }

build() { # platform tag context [build args...]
  plat=$1 tag=$2 ctx=$3; shift 3
  log "build $tag ($plat)"
  # Apple container restarts its builder with 2 CPUs / 2 GB unless told otherwise; the NativeAOT build needs ~12 GB.
  extra=""; [ "$RT" = container ] && extra="--cpus ${STUDY_BUILD_CPUS:-8} --memory ${STUDY_BUILD_MEMORY:-12g}"
  $RT build $extra --platform "$plat" -t "$tag" "$@" "$ctx"
}

run_ctr() { # platform image [run args...] -- [cmd...]
  plat=$1 image=$2; shift 2
  # Files the containers write into results/ are handed back to the caller (matters on Linux, where uids are shared).
  $RT run --rm --platform "$plat" --cpus "$CPUS" --memory "$MEMORY" -e "STUDY_HOST_UID=$(id -u)" -e "STUDY_HOST_GID=$(id -g)" "$@"
}

cmd_images() {
  langs=${*:-"csharp typescript python php cpp kotlin java java-kotlin shell css"}
  plats=""
  for l in $langs; do p=$(platform_of "$l"); case " $plats " in *" $p "*) ;; *) plats="$plats $p" ;; esac; done
  for p in $plats; do
    a=$(arch_tag "$p")
    build "$p" "$SHARPRAIL_TAG-$a" harness/images/sharprail
    build "$p" "study/agent:$a" harness/images/agent --build-arg "SHARPRAIL_IMAGE=$SHARPRAIL_TAG-$a"
  done
  done_warm=""
  for l in $langs; do
    p=$(platform_of "$l"); a=$(arch_tag "$p"); w=$(warm_of "$l")
    case " $done_warm " in *" $w "*) continue ;; esac; done_warm="$done_warm $w"
    if [ "$w" = jvm ]; then
      # IntelliJ is opt-in: only STUDY_INTELLIJ=1 records the terms acceptance in harness/intellij.env (yours to give).
      if [ "${STUDY_INTELLIJ:-0}" = 1 ]; then set -- $(grep -v '^#' harness/intellij.env | sed 's/^/--build-arg /'); else set --; fi
      build "$p" "study/warm-jvm:$a" harness/images/warm-jvm --build-arg "AGENT_IMAGE=study/agent:$a" "$@"
    else
      build "$p" "study/warm-$w:$a" harness/images/warm --build-arg "AGENT_IMAGE=study/agent:$a" --build-arg "SERVERS=$(servers_of "$l")"
    fi
  done
}

project_lang() { echo "${1%-*}"; }

cmd_project() {
  for proj in "$@"; do
    d=projects/$proj; [ -f "$d/project.toml" ] || die "no $d/project.toml"
    l=$(project_lang "$proj"); p=$(platform_of "$l"); a=$(arch_tag "$p")
    repo=$(toml_get "$d/project.toml" repo); commit=$(toml_get "$d/project.toml" commit)
    [ -n "$repo" ] && [ -n "$commit" ] || die "$d/project.toml needs repo and commit"
    [ -f "$d/prepare.sh" ] || die "$d/prepare.sh missing (an empty script is fine)"
    build "$p" "study/run-$proj" "$d" -f harness/images/run/Dockerfile \
      --build-arg "WARM_IMAGE=study/warm-$(warm_of "$l"):$a" --build-arg "REPO=$repo" --build-arg "COMMIT=$commit"
    build "$p" "study/grade-$proj" "$d" -f "$d/Dockerfile.grade" --build-arg "REPO=$repo" --build-arg "COMMIT=$commit"
  done
}

cmd_probe() {
  proj=$1 mode=${2:-enforced}
  d=projects/$proj; l=$(project_lang "$proj"); p=$(platform_of "$l")
  out=$ROOT/results/probe/$proj-$mode; rm -rf "$out"; mkdir -p "$out" "$out.in"
  cp "$d/probe.json" "$out.in/probe.json"; cp harness/bin/probe-inside.sh "$out.in/"
  lic=${STUDY_INTELLIJ_LICENSE:-$ROOT/license.zip}
  STUDY_LICENSE_ZIP_B64=""; [ -f "$lic" ] && STUDY_LICENSE_ZIP_B64=$(base64 < "$lic" | tr -d '\n'); export STUDY_LICENSE_ZIP_B64
  run_ctr "$p" "study/run-$proj" -v "$out.in:/in:ro" -v "$out:/out" ${STUDY_LICENSE_ZIP_B64:+-e STUDY_LICENSE_ZIP_B64} \
    -e "POLL_S=${POLL_S:-180}" "study/run-$proj" probe bash /in/probe-inside.sh "$mode"
  rm -rf "$out.in"
  log "probe results: $out/probe.jsonl"
}

# Grading runs in the project's grade image; answer tasks are scored there too (the grader needs only sh and awk).
grade_dir() { # project task-dir patch-file out-dir
  proj=$1 task=$2 patch=$3 out=$4
  l=$(project_lang "$proj"); p=$(platform_of "$l")
  mkdir -p "$out"
  run_ctr "$p" "study/grade-$proj" --network none \
    -v "$ROOT/$task:/task:ro" -v "$ROOT/projects/$proj:/project:ro" -v "$ROOT/harness/grade:/grade:ro" \
    -v "$(cd "$(dirname "$patch")" && pwd):/run:ro" -v "$out:/out" \
    --entrypoint /bin/sh "study/grade-$proj" /grade/grade.sh "/run/$(basename "$patch")"
}

cmd_validate() {
  for proj in "$@"; do
    for task in tasks/"$proj"/*/; do
      task=${task%/}; id=$(basename "$task"); v=$ROOT/results/validate/$proj/$id; rm -rf "$v"; mkdir -p "$v"
      : > "$v/empty.diff"
      grade_dir "$proj" "$task" "$v/empty.diff" "$v/start" >/dev/null 2>&1 || true
      if [ -f "$task/gold.patch" ]; then cp "$task/gold.patch" "$v/gold.diff"
      else # answer task: the oracle as the answer
        printf 'diff --git a/ANSWER.txt b/ANSWER.txt\nnew file mode 100644\n--- /dev/null\n+++ b/ANSWER.txt\n@@ -0,0 +1,%s @@\n' "$(wc -l < "$task/oracle.txt" | tr -d ' ')" > "$v/gold.diff"
        sed 's/^/+/' "$task/oracle.txt" >> "$v/gold.diff"
      fi
      grade_dir "$proj" "$task" "$v/gold.diff" "$v/gold1" >/dev/null 2>&1 || true
      grade_dir "$proj" "$task" "$v/gold.diff" "$v/gold2" >/dev/null 2>&1 || true
      s=$(sed -n 's/.*"success":\([a-z]*\).*/\1/p' "$v/start/result.json" 2>/dev/null)
      g1=$(sed -n 's/.*"success":\([a-z]*\).*/\1/p' "$v/gold1/result.json" 2>/dev/null)
      g2=$(sed -n 's/.*"success":\([a-z]*\).*/\1/p' "$v/gold2/result.json" 2>/dev/null)
      ok=VALID; [ "$s" = false ] && [ "$g1" = true ] && [ "$g2" = true ] || ok=INVALID
      echo "$ok $proj/$id start=$s gold=$g1,$g2"
    done
  done
}

cmd_run_one() {
  plan=$1 rid=$2
  P=$ROOT/results/$plan; line=$(awk -F'\t' -v r="$rid" '$1==r' "$P/plan.tsv")
  [ -n "$line" ] || die "no run $rid in $P/plan.tsv"
  # plan.tsv columns: run_id project task arm model rep effort budget max_turns timeout_s
  set -- $(echo "$line" | tr '\t' ' ')
  rid=$1 proj=$2 task=$3 arm=$4 model=$5 effort=$7 budget=$8 turns=$9; shift 9; tmo=$1
  out=$P/runs/$rid; [ -f "$out/exit.json" ] && { log "skip $rid (done)"; return 0; }
  rm -rf "$out" "$out.in"; mkdir -p "$out" "$out.in"
  tdir=tasks/$proj/$task
  { cat harness/prompt-preamble.md; cat "$tdir/prompt.md"; } > "$out.in/prompt.md"
  [ -f "$tdir/setup.patch" ] && cp "$tdir/setup.patch" "$out.in/setup.patch"
  [ -f "harness/arms/$arm/mcp.json" ] && cp "harness/arms/$arm/mcp.json" "$out.in/mcp.json"
  # The IntelliJ arms reuse their SharpRail twin's workspace overlay (CLAUDE.md, hooks), so the two cannot drift apart.
  ov=harness/arms/$arm/overlay; [ -d "$ov" ] || ov=harness/arms/${arm#intellij-}/overlay
  case "$arm" in intellij-*|enforced|optional) ;; *) ov=/nonexistent ;; esac
  [ -d "$ov" ] && cp -R "$ov" "$out.in/arm"
  l=$(project_lang "$proj"); p=$(platform_of "$l")
  [ "$effort" = - ] && effort=""
  log "run $rid $proj/$task arm=$arm model=$model"
  run_ctr "$p" "study/run-$proj" -v "$out.in:/in:ro" -v "$out:/out" \
    -e ARM="$arm" -e MODEL="$model" -e EFFORT="$effort" -e MAX_BUDGET_USD="$budget" -e MAX_TURNS="$turns" -e TIMEOUT_S="$tmo" \
    ${ANTHROPIC_API_KEY:+-e ANTHROPIC_API_KEY} ${CLAUDE_CODE_OAUTH_TOKEN:+-e CLAUDE_CODE_OAUTH_TOKEN} \
    ${STUDY_LICENSE_ZIP_B64:+-e STUDY_LICENSE_ZIP_B64} \
    "study/run-$proj" > "$out/container.log" 2>&1 || log "run $rid: container exited $?"
  cp -R "$out.in" "$out/in" && rm -rf "$out.in"
  # The arm and task inputs are kept, minus nothing secret (no credential ever reaches /in).
}

cmd_run() {
  plan=$1; shift; j=3
  [ "${1:-}" = -j ] && j=$2
  # The credential: from the environment, else from an env file (KEY=value lines), never from the command line.
  envf=${STUDY_ENV_FILE:-$HOME/.config/sharprail-study/env}
  if [ -z "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -f "$envf" ]; then
    ANTHROPIC_API_KEY=$(sed -n 's/^ANTHROPIC_API_KEY=//p' "$envf" | tr -d '"'"'"' \r')
    CLAUDE_CODE_OAUTH_TOKEN=$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' "$envf" | tr -d '"'"'"' \r')
  fi
  [ -n "${ANTHROPIC_API_KEY:-}${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || die "set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN, or put one in $envf"
  # A JetBrains offline-activation zip for the IntelliJ arms (optional): ./license.zip, or STUDY_INTELLIJ_LICENSE.
  # It travels base64-encoded in an environment variable, never as a mount the agent could read.
  lic=${STUDY_INTELLIJ_LICENSE:-$ROOT/license.zip}
  STUDY_LICENSE_ZIP_B64=""; [ -f "$lic" ] && STUDY_LICENSE_ZIP_B64=$(base64 < "$lic" | tr -d '\n')
  export ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN STUDY_RUNTIME STUDY_LICENSE_ZIP_B64
  tail -n +2 "results/$plan/plan.tsv" | cut -f1 | xargs -P "$j" -n 1 "$ROOT/study" run-one "$plan"
}

cmd_grade() {
  plan=$1; shift; j=3
  [ "${1:-}" = -j ] && j=$2
  tail -n +2 "results/$plan/plan.tsv" | cut -f1 | xargs -P "$j" -n 1 "$ROOT/study" grade-one "$plan"
}

cmd_grade_one() {
  plan=$1 rid=$2; P=$ROOT/results/$plan; out=$P/runs/$rid
  [ -f "$out/exit.json" ] || return 0
  [ -f "$out/grade/result.json" ] && return 0
  line=$(awk -F'\t' -v r="$rid" '$1==r' "$P/plan.tsv"); set -- $(echo "$line" | tr '\t' ' ')
  run_dir=$out  # grade_dir reuses the name `out` (POSIX sh has no locals)
  grade_dir "$2" "tasks/$2/$3" "$run_dir/patch.diff" "$run_dir/grade" > "$run_dir/grade.log" 2>&1 || true
  log "graded $rid: $(cat "$run_dir/grade/result.json" 2>/dev/null || echo none)"
}

cmd_plan() {
  name=$1; shift
  mkdir -p "results/$name"
  run_ctr "linux/$(native_arch)" "study/agent:$(native_arch)" -v "$ROOT:/study-root" --entrypoint /bin/bash \
    "study/agent:$(native_arch)" /study-root/analysis/plan.sh "$name" "$@"
  log "wrote results/$name/plan.tsv ($(($(wc -l < "results/$name/plan.tsv") - 1)) runs)"
}

cmd_analyze() {
  name=$1
  build "linux/$(native_arch)" study/analysis analysis
  run_ctr "linux/$(native_arch)" study/analysis -v "$ROOT:/study-root" study/analysis "$name"
}

c=${1:-}; [ -n "$c" ] || { sed -n '2,20p' "$0"; exit 2; }; shift
case "$c" in
  images) cmd_images "$@" ;;
  project) cmd_project "$@" ;;
  probe) cmd_probe "$@" ;;
  validate) cmd_validate "$@" ;;
  plan) cmd_plan "$@" ;;
  run) cmd_run "$@" ;;
  run-one) cmd_run_one "$@" ;;
  grade) cmd_grade "$@" ;;
  grade-one) cmd_grade_one "$@" ;;
  analyze) cmd_analyze "$@" ;;
  *) die "unknown command $c" ;;
esac
